edge="1" parent="1" source="head4" target="opt4-7"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="opt4-8" value="9. หลายตำแหน่ง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#64748b;fontColor=#172b3a;fontFamily=Tahoma;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1150" y="766" width="260" height="48" /></mxCell><mxCell id="ed4-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#577185;" edge="1" parent="1" source="head4" target="opt4-8"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="opt4-9" value="10. อื่น ๆ / ไม่ระบุ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#64748b;fontColor=#172b3a;fontFamily=Tahoma;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1150" y="823" width="260" height="48" /></mxCell><mxCell id="ed4-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#577185;" edge="1" parent="1" source="head4" target="opt4-9"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="footer" value="ข้อสังเกตจากเอกสารอาจารย์: รหัส Nature ในหัวข้อกับตัวอย่างกระดูกหักบางจุดไม่ตรงกัน&lt;br&gt;ให้เขียนชื่อการบาดเจ็บจริงให้ชัดและยึดตารางที่อาจารย์กำหนด ไม่เดารหัสหรือผลรักษา&lt;br&gt;แบบนี้จัดใหม่จากหัวข้อบทเรียน ไม่ใช่ไฟล์ผลงานของนักศึกษาคนอื่น" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0c2;strokeColor=#64748b;fontColor=#172b3a;fontFamily=Tahoma;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1210" width="1380" height="140" /></mxCell></root></mxGraphModel></diagram></mxfile>