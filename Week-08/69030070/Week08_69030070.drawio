      <mxCell id="title" value="Week 08 : Tokai Student Rocket Project&lt;br&gt;Naruesorn Phosorn | 69030070" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0f7;fontFamily=Thonburi;fontSize=21;fontStyle=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="15" width="930" height="70" /></mxCell><mxCell id="scenario" value="สมมติ: มือเฉี่ยวขอบชิ้นส่วนโลหะบนโต๊ะจนเกิดแผล&lt;br&gt;ผลที่เลือกเป็นกรณีบาดเจ็บชั่วคราว ยังไม่มีเหตุบาดเจ็บจริง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;fontFamily=Thonburi;fontSize=17;fontStyle=0;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="100" width="930" height="80" /></mxCell><mxCell id="area" value="ทั้ง 3 บูธอยู่ในพื้นที่จัดแสดงเดียวกัน — ไม่ครบเงื่อนไข 3 พื้นที่" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;fontFamily=Thonburi;fontSize=17;fontStyle=0;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="195" width="930" height="45" /></mxCell><mxCell id="head0" value="ความร้ายแรง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0f7;fontFamily=Thonburi;fontSize=12;fontStyle=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="20.0" y="245" width="120" height="30" /></mxCell><mxCell id="head1" value="ลักษณะการเกิดเหตุ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0f7;fontFamily=Thonburi;fontSize=12;fontStyle=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="220.0" y="245" width="120" height="30" /></mxCell><mxCell id="head2" value="ตัวการก่อเหตุ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0f7;fontFamily=Thonburi;fontSize=12;fontStyle=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="420.0" y="245" width="120" height="30" /></mxCell><mxCell id="head3" value="ลักษณะบาดเจ็บ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0f7;fontFamily=Thonburi;fontSize=12;fontStyle=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="590.0" y="245" width="120" height="30" /></mxCell><mxCell id="head4" value="ตำแหน่งบาดเจ็บ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0f7;fontFamily=Thonburi;fontSize=12;fontStyle=1;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="830.0" y="245" width="120" height="30" /></mxCell><mxCell id="footer" value="สีเหลือง = ตัวเลือกของสถานการณ์สมมติในรายงาน ไม่ใช่สถิติอุบัติเหตุจริง&lt;br&gt;ใช้แบบจำแนก ILO จาก Week-08 ของอาจารย์ และคงรายการตัวเลือกเดิม" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0f7;fontFamily=Thonburi;fontSize=14;fontStyle=0;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="1200" width="930" height="50" /></mxCell></root>
